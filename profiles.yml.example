# Copy to profiles.yml (gitignored), or point DBT_PROFILES_DIR at this folder.
# Default target is `sample` so nothing touches real data by accident.
personal_finance:
  target: sample
  outputs:
    sample:
      type: duckdb
      path: "{{ env_var('FIN_SAMPLE_DUCKDB_PATH', 'data/sample/sample.duckdb') }}"
      threads: 4
    real:
      type: duckdb
      path: "{{ env_var('FIN_DUCKDB_PATH', 'data/finance.duckdb') }}"
      threads: 4
